{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run check:locales && node scripts/prepare-product-thumbnails.mjs && vinext build && node scripts/prepare-static.mjs",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:locales": "node scripts/check-locales.mjs",
    "audit:site": "lhci autorun",
    "check:release": "python3 scripts/validate-static.py && python3 scripts/check-phase-four.py && python3 scripts/check-phase-five.py && node scripts/check-quote-retry.mjs && node scripts/check-product-thumbnails.mjs && node scripts/check-analytics-consent.mjs && python3 scripts/check-indexnow.py && python3 scripts/check-guide-navigation.py && python3 scripts/check-search-quality.py && python3 scripts/check-content-quality.py",
    "audit:enquiry": "node scripts/check-quote-browser.mjs",
    "audit:guides": "node scripts/check-guide-browser.mjs",
    "audit:links": "sh scripts/audit-links.sh",
    "audit:catalogue": "node scripts/check-catalogue-browser.mjs",
    "check:article-layout": "node scripts/check-article-layout.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-i18next": "^17.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@lhci/cli": "0.15.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.1",
    "three": "^0.180.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
